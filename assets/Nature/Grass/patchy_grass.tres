shader_parameter/across = PackedVector2Array(-80, 64, -80, 64, -80, 64, -80, 64, -80, 64, -80, 64, -80, 64, -91, 70, -91, 70, -91, 70, -91, 70, -91, 70, -91, 70)
shader_parameter/along = PackedVector2Array(80, 64, 80, 64, 80, 64, 80, 64, 80, 64, 80, 64, 68, 64, 91, 70, 91, 70, 91, 70, 91, 70, 91, 70, 91, 70)
