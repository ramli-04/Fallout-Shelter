OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=2m
INFERENCE_TIMEOUT=30
QUEUE_TIMEOUT=8
MAX_PENDING=1
AI_PORT=8765
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=128
LLM_CONCURRENCY=3
LLM_PER_MODEL_CONCURRENCY=1
OLLAMA_NUM_PARALLEL=1
LLM_QUEUE_LIMIT=128
LLM_QUEUE_TIMEOUT=20
LLM_POOL_MODE=multi
LLM_FALLBACK_MODEL=llama3.2:1b
LLM_AUTO_SINGLE=false
AI_MEMORY_BUDGET_GB=10
OLLAMA_MAX_LOADED_MODELS=3
# Reserve approximately 2 GiB of VRAM for rendering/other GPU users.
OLLAMA_GPU_OVERHEAD=2147483648
# New llama.cpp runner free-memory fitting margin, in MiB.
LLAMA_ARG_FIT_TARGET=2048
